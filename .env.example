# Copy to .env and fill in. Never commit .env.

# development | production. Production enforces https, an encryption key and safe defaults.
APP_ENV=development
# The URL people use to open OncallKit. Used for OAuth redirects, cookies and links in Discord.
PUBLIC_URL=http://localhost:8080

# PostgreSQL password used by docker-compose.yml (DATABASE_URL is built from it there).
POSTGRES_PASSWORD=change-me
# When running the API outside Compose, set DATABASE_URL directly:
# DATABASE_URL=postgres://oncallkit:change-me@localhost:5432/oncallkit

# Google sign-in (https://console.cloud.google.com/apis/credentials).
# Authorised redirect URI: <PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in: open | invite_only | domains (defaults to invite_only in production).
REGISTRATION_MODE=open
# For REGISTRATION_MODE=domains, comma-separated:
# ALLOWED_EMAIL_DOMAINS=example.com
# Who may create organizations: anyone | instance_admins (defaults to instance_admins in production).
ORG_CREATION=anyone

# 32 random bytes, base64. Encrypts Discord webhook URLs at rest. Required in production.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Local development only: sign in with any email, without Google. Refused when APP_ENV=production.
AUTH_DEV_LOGIN=false

# Optional
# SESSION_TTL_HOURS=168
# METRICS_TOKEN=            # if set, /metrics requires "Authorization: Bearer <token>"
# RUN_WORKER=true           # set false on API replicas if you run `oncallkit worker` separately
# LOG_JSON=true             # defaults to true in production
# RUST_LOG=info
